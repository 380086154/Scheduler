<Window x:Class="Scheduler.App.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Scheduler.App.Ui"
        Title="{DynamicResource WindowTitle}"
        Height="720" Width="820"
        MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="PageTagStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="#F4F5F7" BorderBrush="#D0D5DD" BorderThickness="1"
                                CornerRadius="4" Padding="12,0">
                            <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="#333" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1B4F72" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#1B4F72" />
                                <Setter TargetName="Content" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#E6E8EC" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right"
                    Height="32"
                    VerticalAlignment="Center"
                    Click="LanguageButton_OnClick"
                    Padding="8,4"
                    ToolTip="{DynamicResource SwitchLanguageToolTip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ChineseLabel" Text="中文" />
                    <TextBlock Text=" | " />
                    <TextBlock x:Name="EnglishLabel" Text="English" />
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="SettingsTag" Style="{StaticResource PageTagStyle}" GroupName="SettingsPage"
                             Content="{DynamicResource TagSettings}" Checked="PageTag_OnChecked" />
                <RadioButton x:Name="HolidayTag" Style="{StaticResource PageTagStyle}" GroupName="SettingsPage"
                             Content="{DynamicResource TagHoliday}" Checked="PageTag_OnChecked" />
            </StackPanel>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button x:Name="TestButton" Margin="0,0,8,0" Click="TestButton_OnClick">
                    <AccessText Text="{DynamicResource SendTest}" />
                </Button>
                <Button x:Name="SaveButton" Click="SaveButton_OnClick">
                    <AccessText Text="{DynamicResource Save}" />
                </Button>
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#555" TextWrapping="Wrap" MaxWidth="520" />
        </DockPanel>

        <Grid>
            <Grid x:Name="SettingsPage">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox Header="{DynamicResource TodayStatus}" Padding="8" Margin="0,0,0,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Click="RefreshStatus_OnClick">
                        <AccessText Text="{DynamicResource Refresh}" />
                    </Button>
                    <TextBlock x:Name="TodayStatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="{DynamicResource NotificationChannel}" Padding="8" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Content="{DynamicResource Provider}" VerticalAlignment="Center" />
                    <ComboBox x:Name="ProviderCombo" Grid.Column="1" Margin="0,4" SelectionChanged="ProviderCombo_OnSelectionChanged" />
                    <Label Grid.Column="2" Content="{DynamicResource Webhook}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBox x:Name="WebhookBox" Grid.Column="3" Margin="0,4" />
                    <TextBlock x:Name="WebhookHint" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Foreground="#666" TextWrapping="Wrap" Margin="0,4,0,0" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="{DynamicResource ReminderRules}" Padding="8" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Click="AddRule_OnClick" Margin="0,0,8,0">
                                <AccessText Text="{DynamicResource Add}" />
                            </Button>
                            <Button Click="DeleteRule_OnClick">
                                <AccessText Text="{DynamicResource Delete}" />
                            </Button>
                        </StackPanel>
                        <ListBox x:Name="RuleList" SelectionChanged="RuleList_OnSelectionChanged" />
                    </DockPanel>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="RuleEditor">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Label Content="{DynamicResource Enabled}" />
                            <CheckBox x:Name="RuleEnabled" Grid.Column="1" VerticalAlignment="Center" />

                            <Label Grid.Row="1" Content="{DynamicResource RuleKind}" />
                            <ComboBox x:Name="RuleKind" Grid.Row="1" Grid.Column="1" Margin="0,4" SelectionChanged="RuleKind_OnSelectionChanged" />

                            <Label Grid.Row="2" Content="{DynamicResource Title}" />
                            <TextBox x:Name="RuleTitle" Grid.Row="2" Grid.Column="1" Margin="0,4" />

                            <Label x:Name="RuleTimeLabel" Grid.Row="3" Content="{DynamicResource Time}" />
                            <TextBox x:Name="RuleTime" Grid.Row="3" Grid.Column="1" Margin="0,4" ToolTip="{DynamicResource TimeToolTip}" />

                            <Label x:Name="RuleProcessLabel" Grid.Row="4" Content="{DynamicResource ProcessNames}" Visibility="Collapsed" />
                            <TextBox x:Name="RuleProcess" Grid.Row="4" Grid.Column="1" Margin="0,4" Visibility="Collapsed" ToolTip="{DynamicResource ProcessNamesToolTip}" />

                            <Label x:Name="RuleAbsentLabel" Grid.Row="5" Content="{DynamicResource AbsentMinutes}" Visibility="Collapsed" />
                            <TextBox x:Name="RuleAbsentMinutes" Grid.Row="5" Grid.Column="1" Margin="0,4" Visibility="Collapsed" ToolTip="{DynamicResource AbsentMinutesToolTip}" />

                            <Label Grid.Row="6" Content="{DynamicResource Schedule}" />
                            <ComboBox x:Name="RuleSchedule" Grid.Row="6" Grid.Column="1" Margin="0,4" />

                            <Label x:Name="RuleOfficeLabel" Grid.Row="7" Content="{DynamicResource OfficeMinutes}" />
                            <TextBox x:Name="RuleOfficeMinutes" Grid.Row="7" Grid.Column="1" Margin="0,4" ToolTip="{DynamicResource OfficeMinutesToolTip}" />

                            <Label Grid.Row="8" Content="{DynamicResource Message}" />
                            <TextBox x:Name="RuleMessage" Grid.Row="8" Grid.Column="1" Margin="0,4"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="120" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </GroupBox>

            <StackPanel Grid.Row="3" Orientation="Horizontal">
                <CheckBox x:Name="StartWithWindowsBox" Margin="0,0,24,0">
                    <AccessText Text="{DynamicResource StartWithWindows}" />
                </CheckBox>
                <CheckBox x:Name="InputStatsBox">
                    <AccessText Text="{DynamicResource InputStats}" />
                </CheckBox>
            </StackPanel>
            </Grid>
            <local:HolidayCalendarPanel x:Name="HolidayPanel" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
