<Window x:Class="Scheduler.App.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WindowTitle}"
        Height="620" Width="820"
        MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right"
                    Click="LanguageButton_OnClick"
                    Padding="8,4"
                    ToolTip="{DynamicResource SwitchLanguageToolTip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ChineseLabel" Text="中文" />
                    <TextBlock Text=" | " />
                    <TextBlock x:Name="EnglishLabel" Text="English" />
                </StackPanel>
            </Button>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#555" TextWrapping="Wrap" MaxWidth="480" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="TestButton" Content="{DynamicResource SendTest}" Margin="0,0,8,0" Click="TestButton_OnClick" />
                <Button x:Name="SaveButton" Content="{DynamicResource Save}" Click="SaveButton_OnClick" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox Header="{DynamicResource TodayStatus}" Padding="8" Margin="0,0,0,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{DynamicResource Refresh}" Click="RefreshStatus_OnClick" />
                    <TextBlock x:Name="TodayStatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="{DynamicResource NotificationChannel}" Padding="8" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Content="{DynamicResource Provider}" VerticalAlignment="Center" />
                    <ComboBox x:Name="ProviderCombo" Grid.Column="1" Margin="0,4" SelectionChanged="ProviderCombo_OnSelectionChanged" />
                    <Label Grid.Column="2" Content="{DynamicResource Webhook}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBox x:Name="WebhookBox" Grid.Column="3" Margin="0,4" />
                    <TextBlock x:Name="WebhookHint" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Foreground="#666" TextWrapping="Wrap" Margin="0,4,0,0" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="{DynamicResource ReminderRules}" Padding="8" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{DynamicResource Add}" Click="AddRule_OnClick" Margin="0,0,8,0" />
                            <Button Content="{DynamicResource Delete}" Click="DeleteRule_OnClick" />
                        </StackPanel>
                        <ListBox x:Name="RuleList" SelectionChanged="RuleList_OnSelectionChanged" />
                    </DockPanel>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="RuleEditor">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Label Content="{DynamicResource Enabled}" />
                            <CheckBox x:Name="RuleEnabled" Grid.Column="1" VerticalAlignment="Center" />

                            <Label Grid.Row="1" Content="{DynamicResource Title}" />
                            <TextBox x:Name="RuleTitle" Grid.Row="1" Grid.Column="1" Margin="0,4" />

                            <Label Grid.Row="2" Content="{DynamicResource Time}" />
                            <TextBox x:Name="RuleTime" Grid.Row="2" Grid.Column="1" Margin="0,4" ToolTip="{DynamicResource TimeToolTip}" />

                            <Label Grid.Row="3" Content="{DynamicResource Schedule}" />
                            <ComboBox x:Name="RuleSchedule" Grid.Row="3" Grid.Column="1" Margin="0,4" />

                            <Label Grid.Row="4" Content="{DynamicResource OfficeMinutes}" />
                            <TextBox x:Name="RuleOfficeMinutes" Grid.Row="4" Grid.Column="1" Margin="0,4" ToolTip="{DynamicResource OfficeMinutesToolTip}" />

                            <Label Grid.Row="5" Content="{DynamicResource Message}" />
                            <TextBox x:Name="RuleMessage" Grid.Row="5" Grid.RowSpan="2" Grid.Column="1" Margin="0,4"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="120" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </GroupBox>

            <StackPanel Grid.Row="3" Orientation="Horizontal">
                <CheckBox x:Name="StartWithWindowsBox" Content="{DynamicResource StartWithWindows}" Margin="0,0,24,0" />
                <CheckBox x:Name="InputStatsBox" Content="{DynamicResource InputStats}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
